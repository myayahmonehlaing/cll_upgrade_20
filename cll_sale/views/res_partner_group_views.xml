<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="action_partner_group_records" model="ir.actions.act_window">
        <field name="name">Patient Category</field>
        <field name="res_model">res.partner.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a patient group
            </p>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_partner_group_form" model="ir.ui.view">
        <field name="name">res.partner.group.form</field>
        <field name="model">res.partner.group</field>
        <field name="arch" type="xml">
            <form string="Patient Categories">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_partner_group_tree" model="ir.ui.view">
        <field name="name">res.partner.group.tree</field>
        <field name="model">res.partner.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_res_partner_group"
        name="Patient Category"
        parent="sale.menu_sale_config"
        action="action_partner_group_records"
        sequence="25"/>

</odoo>
