<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <record id="product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">15</field>
        <field name="arch" type="xml">
              <xpath expr="//group[@name='group_general']" position="inside">
                    <field name="retail_class_id"/>
              </xpath>
              <xpath expr="//form[@name='Product Template']/sheet[@name='product_form']/notebook[1]/page[@name='general_information']/group[1]/group[@name='group_standard_price']/field[@name='company_id']" position="after">
                      <field name="retail_size_ids" widget="many2many_tags"/>
              </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_inherit" model="ir.ui.view">
            <field name="name">product.template.product.tree.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <field name="categ_id"  position="after">
                    <field name="retail_class_id" optional="show"/>
                     <field name="retail_size_ids" widget="many2many_tags" optional="show"/>
                </field>
            </field>
    </record>

     <record id="product_template_search_view_inherit" model="ir.ui.view">
            <field name="name">product.template.search.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <field name="categ_id"  position="after">
                    <field name="retail_class_id" />
                    <field name="retail_size_ids" />
                </field>
                <filter name="group_by_categ_id" position="after">
                    <filter string="Retail Class" name="group_by_retail_class_id" context="{'group_by':'retail_class_id'}"/>
                     <filter string="Retail Store Size" name="group_by_retail_size_ids" context="{'group_by':'retail_size_ids'}"/>
                </filter>
            </field>
     </record>

    <record id="view_product_retail_class_list" model="ir.ui.view">
        <field name="name">product.retail.class.list</field>
        <field name="model">product.retail.class</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_product_retail_class" model="ir.actions.act_window">
        <field name="name">Retail Class</field>
        <field name="res_model">product.retail.class</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_product_retail_class" sequence="100" name="Retail Classes" parent="sale.product_menu_catalog"
              action="action_product_retail_class"/>

    <record id="view_product_retail_size_list" model="ir.ui.view">
        <field name="name">product.retail.size.list</field>
        <field name="model">product.retail.size</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_product_retail_size" model="ir.actions.act_window">
        <field name="name">Retail Store Size</field>
        <field name="res_model">product.retail.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_retail_size"  sequence="150" name="Retail Store Size" parent="sale.product_menu_catalog"
              action="action_product_retail_size"/>


</odoo>