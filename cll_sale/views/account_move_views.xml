<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_out_invoice_tree_inherit_cll_sale" model="ir.ui.view">
            <field name="name">account.move.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="status_in_payment" position="before">
                    <field name="ehr_invoice_status"/>
                </field>
                <xpath expr="//list/field[@name='invoice_partner_display_name']" position="after">
                    <field name="partner_group_id" optional="show"/>
                    <field name="refer_id" optional="show"/>
                </xpath>

            </field>
        </record>

        <record id="view_move_form_inherit_cll_sale" model="ir.ui.view">
            <field name="name">account.move.form.inherit.cll.sale</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="payment_reference" position="before">
                    <field name="ehr_invoice_status" readonly="1"  invisible="move_type !='out_invoice'"/>
                </field>

                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='invoice_tab']/field[@name='invoice_line_ids']/list[1]/field[@name='discount']"
                       position="after">
                    <field name="discount_amount" optional="show"/>
                    <field name="refer_id" optional="hide"/>
                </xpath>
                <xpath expr="//group[@id='header_left_group']" position="inside">
                    <field name="partner_group_id" readonly="1" invisible="move_type !='out_invoice'"/>
                    <field name="refer_id" invisible="move_type !='out_invoice'" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_move_filter_inherit_cll_sale" model="ir.ui.view">
            <field name="name">account.move.search.inherit.cll.sale</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search/field[@name='name']" position="after">
                    <field name="partner_group_id" string="Patient Category"/>
                    <field name="refer_id" string="Refer Doctor"/>
                </xpath>
                <xpath expr="//search/group" position="inside">
                    <filter string="Patient Category"
                            name="group_by_partner_group"
                            context="{'group_by': 'partner_group_id'}"/>
                     <filter string="Refer Doctor"
                            name="group_by_refer"
                            context="{'group_by': 'refer_id'}"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
