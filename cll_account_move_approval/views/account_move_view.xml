<odoo>
   <data>

     <record id="view_move_form_inherit" model="ir.ui.view">
       <field name="name">account.move.form.inherit</field>
       <field name="model">account.move</field>
       <field name="inherit_id" ref="account.view_move_form"/>
       <field name="arch" type="xml">
            <field name="partner_id" position="after">
                    <field name="user_status" invisible="1"/>
                    <field name="is_employee_advance" invisible="1"/>
                    <field name="use_approval" invisible="1"/>
                 </field>

                 <xpath expr="//form/header/button[@name='action_post'][2]" position="replace">
                       <button name="action_post" string="Confirm" class="oe_highlight" type="object" groups="account.group_account_invoice" data-hotkey="q" context="{'validate_analytic': True}"
                               invisible="use_approval == True or move_type == 'entry'  or hide_post_button or  display_inactive_currency_warning"/>

                       <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="move_type != 'in_invoice' or  use_approval == False or state != 'draft'"/>

                       <button name="approve_approval_approver" type="object" string="Approve " class="oe_highlight" invisible="user_status != 'submit'"/>
                       <button name="%(cll_base_approval_rule.approval_refuse_wizard_action)d"  type="action" string="Refuse " class="oe_highlight" invisible="user_status != 'submit'"/>
                       <button name="action_withdraw"
                            string="Withdraw"
                            invisible = "user_status != 'approve' or state in ('approve','posted')"
                            type="object"
                            data-hotkey="w"/>
                 </xpath>
                 <xpath expr="//div[@name='button_box']" position="after">
                     <field name="approval_condition_status" class="float-end fs-6"
                       widget="badge"
                       decoration-success="1"
                            invisible="not ( use_approval == True) "
                     />
                 </xpath>
                <xpath expr="/form/sheet/group/group[@id='header_right_group']/field[@name='invoice_date'][2]" position="attributes">
                    <attribute name="readonly">
                        state != 'draft' and user_status != 'submit'
                    </attribute>
                </xpath>
                 <field name="invoice_date" position="attributes">
                     <attribute name="readonly">
                        state != 'draft' and user_status != 'submit'
                     </attribute>
                 </field>
                  <field name="invoice_line_ids" position="attributes">
                     <attribute name="readonly">
                        state != 'draft' and user_status != 'submit'
                     </attribute>
                 </field>
                <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/div[@name='journal_div']/field[@name='journal_id']" position="attributes">
                     <attribute name="readonly">
                       state != 'draft' and user_status != 'submit'
                     </attribute>
                </xpath>

                 <button name="button_draft"  position="attributes">
                      <attribute name="groups">cll_account_move_approval.reset_to_draft_permission_group</attribute>
                 </button>
                 <button name="action_register_payment"  position="attributes">
                      <attribute name="groups">cll_account_move_approval.post_and_register_payment_permission_group</attribute>
                 </button>


                 <xpath expr="//page[@id='aml_tab']" position="after">
                      <page string=" Approver(s)" name="advance_approvers" invisible=" use_approval == False">
                            <group>
                                <group>
                                    <field name="approval_condition_ids" widget="many2many_checkboxes" readonly="state !='draft'"/>
                                </group>
                                 <group>
                                      <field name="optional_approver_id" string="Director" options="{'no_create': True}" readonly="state !='draft'"/>
                                      <field name="approval_rule_id"   options="{'no_create': True}" force_save="1" readonly="1" />
                                </group>
                            </group>
                            <field name="approver_ids" mode="list,kanban" readonly="1">
                                <list editable="bottom" decoration-success="status=='approve'" decoration-warning="status in ['submit','waiting']" decoration-danger="status=='cancel'">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="user_id" string="Approver" readonly="status != 'new'" force_save="1" options="{'no_create': True}"/>
                                    <field name="status"/>
                                      <field name="name" string="Role"/>
                                </list>
                                <kanban class="o_kanban_mobile">
                                    <field name="user_id"/>
                                    <field name="status"/>
                                    <templates>
                                        <t t-name="card" class="flex-row">
                                            <field name="user_id"/>
                                            <t t-if="record.status.raw_value">
                                                <t t-set="classname" t-value="{'approved': 'text-bg-success', 'pending': 'text-bg-warning', 'cancel': 'text-bg-danger'}[record.status.raw_value] || 'text-bg-light'"/>
                                                <span t-attf-class="ms-auto rounded-pill {{ classname }}">
                                                    <field name="status"/>
                                                </span>
                                            </t>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="user_id"/>
                                        <field name="company_id" invisible="1"/>
                                    </group>
                                </form>
                            </field>
                     </page>

                 </xpath>
       </field>
       </record>

       <record id="view_move_tree_inherit_approval" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.approval</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='status_in_payment']" position="after">
                     <field name="approval_condition_status" decoration-success="1" optional="show" string="Approval Status" widget="badge"/>
                </xpath>
            </field>
        </record>

       <record id="view_account_move_filter_inherit" model="ir.ui.view">
            <field name="name">account.move.select.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_move_filter"/>
            <field name="arch" type="xml">
                 <filter name="status" position="after">
                      <filter name="approval_condition_status"/>
                 </filter>
            </field>
       </record>

       <record id="model_account_move_approve_batch_request" model="ir.actions.server">
            <field name="name">Approve Batch Request</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list</field>
            <field name="group_ids" eval="[(4, ref('account.group_account_manager'))]"/>
            <field name="state">code</field>
            <field name="code">action = records.action_approve_batch_request()</field>
      </record>


  </data>
</odoo>