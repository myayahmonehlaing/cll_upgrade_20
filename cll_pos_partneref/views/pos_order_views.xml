<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_pos_form_cll_pos" model="ir.ui.view">
            <field name="name">pos.order.form.inherit</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="ref_id" readonly="state == 'invoiced'"/>
                    <field name="clinic_id" readonly="state == 'invoiced'"/>
                </xpath>
            </field>
        </record>

        <record id="view_pos_order_tree_cll_pos" model="ir.ui.view">
            <field name="name">pos.order.form.inherit</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="ref_id"/>
                    <field name="clinic_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
