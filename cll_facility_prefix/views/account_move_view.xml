<odoo>
   <data>
        <record id="view_move_form_prefix_inherit" model="ir.ui.view">
       <field name="name">account.move.form.prefix.inherit</field>
       <field name="model">account.move</field>
       <field name="inherit_id" ref="account.view_move_form"/>
       <field name="arch" type="xml">
            <field name="partner_shipping_id" position="after">
                    <field name="use_facility" invisible="1"/>
                    <field name="facility_id" readonly="state != 'draft'" options="{'no_create': True}" invisible="not use_facility" required="use_facility"/>
            </field>
       </field>
       </record>

            <record model="ir.ui.view" id="view_account_asset_form_inherit">
            <field name="name">account.asset.form.inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                   <xpath expr="//form/sheet/notebook/page/group" position="before">
                        <group>
                            <group>
                             <field name="use_facility" invisible="1"/>
                             <field name="facility_id" readonly="state !='draft'" options="{'no_create': True}" string="Facility" invisible="not use_facility or  state == 'model'" required="use_facility and not state == 'model'" />
                            </group>
                            <group>

                            </group>
                        </group>
                  </xpath>
            </field>
        </record>

       <record model="ir.ui.view" id="view_account_asset_tree_facility_inherit">
         <field name="name">account.asset.tree.facility_inherit</field>
         <field name="model">account.asset</field>
         <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
           <field name="arch" type="xml">

                <field name="value_residual" position="after">
                    <field name="facility_id"  optional="hide"/>

                </field>
           </field>
      </record>


   </data>
</odoo>