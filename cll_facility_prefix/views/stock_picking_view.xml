<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_facility_inherit" model="ir.ui.view">
    <field name="name">stock.picking.form.facility.inherit</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
             <field name="origin" position="after">
<!--                 <field name="code" invisible="1" />-->
                  <field name="use_facility" invisible="1"/>
                     <field name="facility_id" readonly="state in ['done', 'cancel']" options="{'no_create': True}"
                        invisible="not use_facility" required="use_facility"
                     />
             </field>
        </field>
   </record>

</odoo>
