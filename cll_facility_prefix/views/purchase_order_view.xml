<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_purchase_order_form_facility_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.facility.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//div[@name='reminder']" position="after">
                      <field name="use_facility" invisible="1"/>
                     <field name="facility_id" readonly="state in ['cancel', 'done', 'purchase']"
                            options="{'no_create': True}" invisible="not use_facility" required="use_facility"/>
                 </xpath>
            </field>
       </record>

</odoo>
