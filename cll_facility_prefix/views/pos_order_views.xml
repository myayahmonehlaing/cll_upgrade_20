<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_session_form_inherit" model="ir.ui.view">
            <field name="name">pos.session.form.view.inherit</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="facility_id" readonly="1"/>
                </xpath>
            </field>
        </record>
        <record id="view_pos_session_tree_inherit" model="ir.ui.view">
            <field name="name">pos.session.tree.view.inherit</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='config_id']" position="after">
                    <field name="facility_id" readonly="1"/>
                </xpath>
            </field>
        </record>
        <record id="view_pos_order_facility_form" model="ir.ui.view">
            <field name="name">pos.order.form.facility.inherit</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="facility_id" readonly="1"/>
                </xpath>
            </field>
        </record>
        <record id="view_pos_order_faclitty_tree" model="ir.ui.view">
            <field name="name">pos.order.tree.facility.inherit</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="facility_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
