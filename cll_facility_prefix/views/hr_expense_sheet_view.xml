<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.expense.form.inherit</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
            <field name="arch" type="xml">
               <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="use_facility" invisible="1"/>
                    <field name="facility_id"  readonly="not is_editable" options="{'no_create': True}" invisible="not use_facility" required="use_facility"/>
                </xpath>
            </field>
    </record>
