<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_cashbook_form_inherit" model="ir.ui.view">
            <field name="name">account.cashbook.form.inherit</field>
            <field name="model">account.cashbook</field>
            <field name="inherit_id" ref="account_cashbook.view_cashbook_form"/>
           <field name="arch" type="xml">
            <field name="payment_type" position="after">
                 <field name="use_facility" invisible="1"/>
                <field name="facility_id" readonly="state != 'draft'" options="{'no_create': True}" invisible="not use_facility" required="use_facility"/>
            </field>
           </field>
        </record>
</odoo>