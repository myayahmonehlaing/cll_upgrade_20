<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_facility_view_form" model="ir.ui.view">
        <field name="name">res.facility.form</field>
        <field name="model">res.facility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                         <group>
                              <field name="code"  required="True"/>
                        </group>
                        <group>
                              <field name="company_id" required="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_facility_view_tree" model="ir.ui.view">
        <field name="name">res.facility.tree</field>
        <field name="model">res.facility</field>
        <field name="arch" type="xml">
            <list string="Facility" >
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="res_facility_action" model="ir.actions.act_window">
        <field name="name">Facilities</field>
        <field name="res_model">res.facility</field>
        <field name="view_mode">list,form</field>
    </record>

     <menuitem id="res_facility_menu_action" action="res_facility_action" parent="account.account_invoicing_menu" sequence="10"/>
</odoo>
