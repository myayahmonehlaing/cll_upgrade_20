<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email template for user request approval -->
        <record id="email_template_employee_access_approved" model="mail.template">
            <field name="name">Employee Access Control Approved - Notification to Admins</field>
            <field name="model_id" ref="model_employee_access_control"/>
            <field name="subject"> Employee Access Control Request Approved: {{object.name}}</field>
            <field name="email_from">{{object.env.user.email}}</field>
            <field name="lang">{{object.env.user.lang}}</field>
            <field name="auto_delete">True</field>
            <field name="body_html">
                <![CDATA[
<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 10px;">
        User Request Approved - System Administrator Notification
    </h2>
    
    <p>Dear System Administrator,</p>
    
    <p>A new user request has been approved and requires your attention:</p>
    
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
        <tr style="background-color: #f9f9f9;">
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Request ID:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.name"/></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Request Type:</td>
            <td style="padding: 10px; border: 1px solid #ddd;">
                <t t-if="object.is_workspace">
                    <t t-out="object.workspace_type"/>
                </t>
                <t t-else="">
                    <t t-out="object.request_type"/>
                </t>

            </td>
        </tr>
        <tr style="background-color: #f9f9f9;">
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">System:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.system_id.name or ''"/></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Employee:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.employee_id.name or ''"/></td>
        </tr>
        <tr style="background-color: #f9f9f9;">
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Employee Email:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.email or ''"/></td>
        </tr>
        <tr t-if="object.system_id.is_workspace">
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Workspace Email:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.workspace_email or ''"/></td>
        </tr>
        <tr style="background-color: #f9f9f9;">
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Company:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.company_id.name or ''"/></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Position:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.job_id.name or ''"/></td>
        </tr>
        <tr style="background-color: #f9f9f9;">
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Department:</td>
            <td style="padding: 10px; border: 1px solid #ddd;"><t t-out="object.department_id.name or ''"/></td>
        </tr>
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Status:</td>
            <td style="padding: 10px; border: 1px solid #ddd; color: green; font-weight: bold;">APPROVED</td>
        </tr>
    </table>
    
    <t t-if="object.group_ids">
        <h3 style="color: #875A7B; margin-top: 20px;">Requested Roles:</h3>
        <div style="background-color: #f9f9f9; padding: 10px; margin: 10px 0; border-left: 4px solid #875A7B;">
            <t t-foreach="object.group_ids" t-as="role">
                <div style="margin-bottom: 6px;">
                    <span style="display: inline-block; background-color: #e6e6e6; padding: 4px 8px; margin: 2px; border-radius: 3px;">
                        <t t-if="role.application_id">
                        <strong>
                            <t t-out="role.application_id.name"/>
                        </strong>
                        <span class="mx-1">•</span>
                    </t>
                    <t t-out="role.name"/>
                    </span>
                </div>
            </t>
        </div>
    </t>
    
    <t t-if="object.access_companies">
        <h3 style="color: #875A7B; margin-top: 20px;">Access Companies:</h3>
        <div style="background-color: #f9f9f9; padding: 10px; margin: 10px 0; border-left: 4px solid #875A7B;">
            <t t-foreach="object.access_companies" t-as="company">
                <span style="display: inline-block; background-color: #e6e6e6; padding: 4px 8px; margin: 2px; border-radius: 3px;">
                    <t t-out="company.name"/>
                </span>
            </t>
        </div>
    </t>
    
    <t t-if="object.remark">
        <h3 style="color: #875A7B; margin-top: 20px;">Remarks:</h3>
        <div style="background-color: #f0f9ff; padding: 15px; margin: 10px 0; border: 1px solid #ddd; border-radius: 4px;">
            <t t-out="object.remark"/>
        </div>
    </t>
    
    <h3 style="color: #875A7B; margin-top: 30px;">Required Actions:</h3>
    
    <div style="background-color: #f0f9ff; border-left: 4px solid #875A7B; padding: 15px; margin: 20px 0;">
        <p style="margin: 0; font-weight: bold;">Please take the following actions:</p>
        <ul style="margin: 10px 0; padding-left: 20px;">
            <li>Create/update user account in <t t-out="object.system_id.name or 'the system'"/></li>
            <li>Assign requested roles and permissions</li>
            <t t-if="object.access_companies">
                <li>Configure access for specified companies</li>
            </t>
            <li>Send credentials to <t t-out="object.employee_id.name or 'the employee'"/></li>
        </ul>
    </div>
    
    <div style="margin-top: 20px; padding: 15px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 4px;">
        <p style="margin: 0; font-weight: bold;">⚠️ Important Notes:</p>
        <ul style="margin: 5px 0; padding-left: 20px;">
            <li>Please complete the setup within 24 hours</li>
            <li>Notify the requestor once the account is ready</li>
            <li>Document any system-specific configurations applied</li>
        </ul>
    </div>
    
    <p style="margin-top: 30px; font-size: 12px; color: #666;">
        This is an automated notification. Please do not reply to this email.<br/>
        Request ID: <t t-out="object.name or ''"/> | System: <t t-out="object.system_id.name or 'N/A'"/> | Date: <t t-out="datetime.datetime.now().strftime('%Y-%m-%d %H:%M')"/>
    </p>
</div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
