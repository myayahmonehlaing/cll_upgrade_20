<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_cll_system_role_filter" model="ir.ui.view">
        <field name="name">cll.system.role.filter</field>
        <field name="model">cll.system.role</field>
        <field name="arch" type="xml">
            <search string="Search Systems">
                <field name="name"/>
                <field name="application_id"/>
                <field name="system_id"/>
                <separator/>
                <filter string="Odoo" name="search_system_odoo" domain="[('system_id.is_odoo', '=', True)]" />
                <filter string="Workspace" name="search_system_workspace" domain="[('system_id.is_workspace', '=', True)]" />
                <filter string="Other Systems" name="search_system_others" domain="[('system_id.is_odoo', '=', False),('system_id.is_workspace', '=', False)]" />
                <separator/>
                <group>
                    <filter name="group_system" string="System" context="{'group_by':'system_id'}"/>
                    <filter name="group_application" string="Application" context="{'group_by': 'application_id'}"/>
                    <filter name="group_display_type" string="Type" context="{'group_by': 'display_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cll_system_role_form" model="ir.ui.view">
        <field name="name">cll.system.role.form</field>
        <field name="model">cll.system.role</field>
        <field name="arch" type="xml">
            <form string="Group">
                <sheet>
                     <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="display_type"/>
                            <field name="application_id"/>
                             <field name="description"/>
                        </group>
                        <group>
                            <field name="system_id"/>
                            <field name="is_default"/>
                            <field name="sequence"/>
                        </group>
                     </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cll_system_role_tree" model="ir.ui.view">
        <field name="name">cll.system.role.tree</field>
        <field name="model">cll.system.role</field>
        <field name="arch" type="xml">
            <list string="Groups">
                <field name="name"/>
                <field name="application_id"/>
                <field name="description"/>
                <field name="sequence"/>
                <field name="is_default"/>
                <field name="display_type"/>
            </list>
        </field>
    </record>

    <record id="action_cll_system_role" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">cll.system.role</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
