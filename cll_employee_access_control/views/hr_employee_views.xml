<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_employee_system_form" model="ir.ui.view">
        <field name="name">hr.employee.view.system.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
             <page name="hr_settings" position="after">
                 <page name="asset_request" string="Assets">
                     <field name="asset_request_ids" mode="list"/>
                 </page>
                 <page name="system_overview" string="Systems">
                        <field name="system_ids"  mode="kanban" readonly="1">
                                <kanban>
                                    <field name="id"/>
                                    <field name="system_id"/>
                                    <field name="status"/>
                                    <field name="active_date"/>
                                    <field name="inactive_date"/>
                                   <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_card oe_kanban_global_click">
                                                 <div class="o_kanban_image">
                                                    <img alt="System" t-att-src="kanban_image('cll.system', 'image', record.system_id.raw_value)"/>
                                                </div>
                                                 <div class="oe_kanban_details">
                                                    <!-- Header -->
                                                    <div class="o_kanban_header d-flex justify-content-between align-items-center">
                                                        <strong class="o_kanban_record_title">
                                                            <field name="system_id"/>
                                                        </strong>

                                                        <!-- Status badge -->
                                                        <t t-if="record.status.raw_value == 'active'">
                                                            <span class="badge rounded-pill bg-success">
                                                                Active
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge rounded-pill bg-secondary">
                                                                Inactive
                                                            </span>
                                                        </t>
                                                    </div>

                                                <!-- Body -->
                                                    <div class="o_kanban_content mt-2">
                                                        <div class="text-success">
                                                            <i class="fa fa-calendar-check-o me-1"/>
                                                            <span>Active Date:</span>
                                                            <field name="active_date"/>
                                                        </div>

                                                        <div class="text-muted mt-2">
                                                            <i class="fa fa-calendar-times-o me-1"/>
                                                            <span>Inactive Date:</span>
                                                            <field name="inactive_date"/>
                                                        </div>
                                                    </div>

                                            </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                        </field>
                 </page>
             </page>

        </field>
    </record>

