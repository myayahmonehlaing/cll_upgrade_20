<odoo>
   <data>
       <record id="view_account_asset_form_inherit" model="ir.ui.view">
       <field name="name">account.asset.form.inherit</field>
       <field name="model">account.asset</field>
       <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
       <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="code" invisible="state == 'model'" />
                <field name="model" string="Model"  invisible="state == 'model'"/>
                <field name="location_id" string="Location"  invisible="state == 'model'"/>
                <field name="batch_number" invisible="state == 'model'"/>
              </xpath>
       </field>
       </record>

      <record model="ir.ui.view" id="view_account_asset_tree_inherit">
         <field name="name">account.asset.tree.inherit</field>
         <field name="model">account.asset</field>
         <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
           <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="code"/>
                </field>
                <field name="value_residual" position="after">
                    <field name="location_id"  optional="hide"/>
                     <field name="batch_number" optional="hide"/>
                    <field name="analytic_distribution" widget="analytic_distribution" optional="hide"/>
                </field>
           </field>
      </record>

      <record id="view_account_asset_search_inherit" model="ir.ui.view">
        <field name="name">account.asset.search.inherit</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_search"/>
        <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="code"/>
                    <field name="location_id" />
                     <field name="batch_number"  />
                </field>
        </field>
        </record>
   </data>
</odoo>