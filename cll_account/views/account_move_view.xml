      <record id="view_out_invoice_tree_inherit_cll_account" model="ir.ui.view">
            <field name="name">account.move.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
                    <field name="origin" optional="show"/>
                </field>

            </field>
        </record>

       <record id="view_move_form_inherit" model="ir.ui.view">
       <field name="name">account.move.form.inherit</field>
       <field name="model">account.move</field>
       <field name="inherit_id" ref="account.view_move_form"/>
       <field name="arch" type="xml">

           <xpath expr="//field[@name='journal_id']" position="after">
               <field name="is_employee_advance" invisible="1"/>
               <field name="is_vendor_advance" invisible="1"/>
           </xpath>
           <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="partner_id" widget="res_partner_many2one" nolabel="1"
                       context="{'move_type': context.get('default_move_type'),
                                 'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or False,
                                 'show_address': 1,
                                 'default_is_company': True,
                                 'show_vat': True,
                                 'default_is_customer': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt'))}"
                       domain="[('is_customer', '=', True)]"
                       options='{"no_quick_create": True}'
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"
                       readonly="state != 'draft'"/>
                   <field name="partner_id" widget="res_partner_many2one" nolabel="1"
                       context="{'move_type': context.get('default_move_type'),
                                 'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                                 'show_address': 1,
                                 'default_is_company': True,
                                 'show_vat': True,
                                 'default_is_vendor': (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt'))}"
                          domain="[('is_vendor', '=', True)]"
                        options='{"no_quick_create": True}'
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt') or is_employee_advance "
                       readonly="state != 'draft'"/>

                    <field name="partner_id" widget="res_partner_many2one" nolabel="1"
                       context="{'move_type': context.get('default_move_type'),
                                 'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                                 'show_address': 1,
                                 'default_is_company': True,
                                 'show_vat': True }"
                          domain="[('is_employee', '=', True)]"
                        options='{"no_quick_create": True}'
                       invisible="not is_employee_advance"
                       readonly="state != 'draft'"/>
           </xpath>
           <xpath expr="//form/sheet/group/group[@id='header_left_group']/field[@name='ref']" position="after">
                <field name="refund_move_id" invisible="move_type not in ('in_refund')"/>
           </xpath>
           <xpath expr="//button[@name='action_view_source_purchase_orders']" position="after">
                <button name="bill_credit_note" class="oe_highlight"
                        type="object" icon="fa-folder-open" domain="[('refund_move_id', '=', id)]"
                        context="{'search_default_refund_move_id': id, 'default_refund_move_id': id, 'default_move_type': 'in_refund'}"
                        invisible="move_type not in ['in_invoice']">
                    <field widget="statinfo" name="move_count" string="Credit note"/>
                </button>
           </xpath>
           <xpath expr="//label[@for='journal_id']" position="attributes">
                <attribute name="groups">account.group_account_readonly,cll_account.group_employee_advance_user</attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="attributes">
                <attribute name="groups">account.group_account_readonly,cll_account.group_employee_advance_user</attribute>
            </xpath>

           <field name="ref" position="after">
                  <field name="vendor_advance_widget"
                            colspan="2" nolabel="1" widget="advance"
                            invisible="vendor_advance_widget == False "/>
           </field>
           <field name="invoice_user_id" position="before">
                     <field name="origin" readonly="state !='draft'"/>
           </field>
       </field>
       </record>

       <record id="view_move_tree_inherit_cll" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.cll</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="arch" type="xml">
<!--                <xpath expr="//field[@name='state']" position="after">-->
<!--                     <field name="hr_expense_sheet_count" optional="show" string="Related Expense" widget="color_picker"/>-->
<!--                </xpath>-->
                <xpath expr="//field[@name='amount_total_in_currency_signed']" position="after">
                    <field name="amount_total_signed" />
                </xpath>

                <xpath expr="//field[@name='status_in_payment']" position="after">
                    <field name="refund_move" optional="show" string="Related Refund" widget="color_picker"/>
                    <field name="total_advance_amount" optional="hide" />
                    <field name="advance_payable_balance" optional="hide" />
                </xpath>
            </field>
        </record>

