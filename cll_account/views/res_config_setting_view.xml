<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_analytic_filter_report" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.analytic.filter.report</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="inside">
                <setting company_dependent="1" help="Please select this option to show plan name in analytic group by." string="Showing Plan Name in Analytic Group By">
                    <field name="show_plan_analytic_filter"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>