<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.point_of_sale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
             <xpath expr="//block[@id='pos_accounting_section']/setting[@id='pos_default_journals']" position="after">
                  <setting string="Right POS" id="right_pos_custom" >
                       <field name="right_pos" string="Right POS"/>
                           <div class="row" >
                                <label string="Sales" for="sale_journal_id" class="col-lg-3 o_light_label" options="{'no_open': True, 'no_create': True}"/>
                                <field name="sale_journal_id" domain="[('company_id', '=', company_id), ('type', 'in', ('general', 'sale'))]" context="{'default_company_id': company_id, 'default_type': 'general'}" required="pos_company_has_template"/>
                          </div>
                  </setting>
             </xpath>

<!--             <xpath expr="//block[@id='pos_inventory_section']" position="inside">-->
<!--                 <setting title="Transfer Operation types show up in the Inventory dashboard." string="Transfer Operation Type">-->
<!--                     <field name="transfer_picking_type_id" />-->
<!--                </setting>-->
<!--             </xpath>-->


        </field>
    </record>
</odoo>