<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_order_product_form" model="ir.ui.view">
        <field name="name">product.label.layout.form</field>
        <field name="model">pos.order.product</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="no_of_label"/>
                    </group>
                    <group>
                         <field name="start_position"/>
                    </group>
                </group>
                <footer>
                    <button string="Print" type="object" name="process"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_pos_order" model="ir.actions.act_window">
        <field name="name">Choose The number of Product</field>
        <field name="res_model">pos.order.product</field>
        <field name="view_ids"
                eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'form', 'view_id': ref('pos_order_product_form')})]" />
        <field name="target">new</field>
    </record>
</odoo>