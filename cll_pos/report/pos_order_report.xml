<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="paperformat_for_POS_order" model="report.paperformat">
            <field name="name">Custom Label Sheet</field>
            <field name="default" eval="False" />
            <field name="format">custom</field>
            <field name="page_height">240</field>
            <field name="page_width">160</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">2.4</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">3.5</field>
            <field name="margin_right">0.0</field>
            <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_pos" model="ir.actions.report">
        <field name="name">POS Order</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cll_pos.report_posorder_product_label</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'POS - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="cll_pos.paperformat_for_POS_order"/>
    </record>

</odoo>