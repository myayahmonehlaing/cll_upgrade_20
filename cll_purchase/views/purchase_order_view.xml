<?xml version="1.0" encoding="utf-8"?>
<odoo>
       <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                  <xpath expr="/form/sheet/notebook/page[@name='products']/field[@name='order_line']/list//field[@name='date_planned']" position="after">
                     <field name="expired_date" optional="show"/>
                     <field name="procurement_note" optional="show"/>
                  </xpath>

                  <button name="button_unlock" position="after">
                        <button name="button_approval_request" type="object" string="Import Entries From Purchase Requests"  groups="purchase.group_purchase_manager"
                                data-hotkey="l" invisible="not id or state !='draft'"/>
                  </button>

                 <xpath expr="//button[@name='action_view_invoice']" position="after">
                    <button name="action_open_vendor_advance" class="oe_highlight"
                            type="object" icon="fa-folder-open" domain="[('advance_order_id', '=', id)]"
                            context="{'search_default_advance_order_id': id, 'default_advance_order_id': id,'default_partner_id': partner_id, 'default_move_type': 'in_invoice'}"
                            >
                        <field widget="statinfo" name="vendor_advance_count" string="Vendor Advance"/>
                    </button>
                </xpath>

                 <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                    <page string="Attachments" name="attachment">
                         <group >
                             <group >
                                 <field name="attachment_ids" no_label="1" invisible="not id "
                                        widget="many2many_binary" readonly="state in ('done','purchase')"
                                        context="{'default_res_id': id}"/>
                            </group>
                        </group>
                    </page>
                  </xpath>

                <field name="partner_id" position="attributes" >
                     <attribute name="context">
                           {'res_partner_search_mode': 'supplier', 'show_vat': True,'default_is_vendor': True}
                     </attribute>
                </field>
                 <field name="partner_ref" position="after">
                     <field name="refer_specific"/>
                 </field>

            </field>
       </record>

       <record id="purchase.menu_purchase_root" model="ir.ui.menu">
             <field name="group_ids" eval="[(6, 0,
              [ref('purchase.group_purchase_manager'),
              ref('purchase.group_purchase_user'),
               ref('group_purchase_subcon_user'),
             ])]"/>
        </record>

        <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="name">request.quotation.select.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
             <filter name="my_purchases" position="after">
                     <filter name="subcon_purchases" string="Subcon Purchases" domain="[('is_subcontract', '=', True)]"/>
             </filter>
        </field>
        </record>

       <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
            <field name="context">{'search_default_supplier': 1,'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1,
                'default_is_vendor': 1}</field>
       </record>


</odoo>