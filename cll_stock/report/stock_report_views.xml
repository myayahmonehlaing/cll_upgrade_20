<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="action_report_picking_cll" model="ir.actions.report">
            <field name="name">Cll Picking Operations</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">cll_stock.cll_report_picking</field>
            <field name="print_report_name">'CLL Picking Operations - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

       <record id="action_report_delivery_cll" model="ir.actions.report">
            <field name="name">Cll Delivery Slip</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">cll_stock.report_deliveryslip_cll</field>
            <field name="print_report_name">'CLL Delivery Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>