<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="account_cashbook_comp_rule" model="ir.rule">
            <field name="name">Cashbook multi-company</field>
            <field name="model_id" ref="model_account_cashbook"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="account_cashbook_line_comp_rule" model="ir.rule">
            <field name="name">Cashbook Line multi-company</field>
            <field name="model_id" ref="model_account_cashbook_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>