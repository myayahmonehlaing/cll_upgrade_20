<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_activity_data_base_approval" model="mail.activity.type">
            <field name="name">Base Approval</field>
            <field name="icon">fa-check-circle</field>
            <field name="sequence">5</field>
            <field name="res_model">approval.approver.approver</field>
        </record>

        <template id="approval_template_refuse_reason">
            <p>Your Approval for
                <span t-if="name != '/'" t-esc="name"/> has been refused</p>
        <ul class="o_timeline_tracking_value_list">
            <li>Reason : <t t-esc="reason"/>
            </li>
        </ul>
    </template>
    <template id="approval_template_approve">
        <p>Your Approval <t t-esc="name"/> has been approved</p>
</template>
</data>
</odoo>
