<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_move_form_currency_inherit" model="ir.ui.view">
            <field name="name">account.move.form.currency.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                  <xpath expr="//div[@name='journal_div']" position="after">
                     <field name="is_multiple_currency" invisible="1"/>
                  </xpath>
                  <xpath expr="//div[@name='currency_conversion_div']" position="replace">
                     <div name="currency_conversion_div" class="d-flex gap-1 text-muted" invisible="currency_id == company_currency_id">
                        <span>1</span>
                        <field name="currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                        <span>=</span>
                        <field name="currency_rate" digits="[12,2]" readonly="state != 'draft'"/>
                        <field name="company_currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                    </div>
                 </xpath>
            </field>
        </record>
    </data>
</odoo>